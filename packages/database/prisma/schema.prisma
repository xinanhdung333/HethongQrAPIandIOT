generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String              @map("password_hash")
  avatarUrl          String?             @map("avatar_url")
  fullName           String?             @map("full_name")
  phone              String?
  addressLine        String?             @map("address_line")
  provinceName       String?             @map("province_name")
  provinceCode       String?             @map("province_code")
  districtName       String?             @map("district_name")
  districtCode       String?             @map("district_code")
  wardName           String?             @map("ward_name")
  wardCode           String?             @map("ward_code")
  role               UserRole            @default(CUSTOMER)
  rentals            RentalOrder[]
  scheduledRentals   Rental[]
  inventoryLogs      InventoryLog[]
  shows              Show[]
  apiKeys            ApiKey[]
  apiRentals         ApiRentalOrder[]
  externalQrCodes    ExternalQrCode[]
  externalQrScanLogs ExternalQrScanLog[]
  payoutAccounts     PayoutAccount[]
  paymentTransactions PaymentTransaction[]
  apiNotifications   ApiNotification[]
  payouts            Payout[]            @relation("ShowOwnerPayouts")
  activityLogs       ActivityLog[]
  revokedResources   RevokedResource[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id             String        @id @default(cuid())
  /// Mã nghiệp vụ mới: LK-, TBB- hoặc TBT- + mã định danh.
  sku            String?       @unique
  slug           String        @unique
  name           String
  categoryId     String?       @map("category_id")
  productType    CatalogProductType? @map("product_type")
  status         ProductStatus @default(ACTIVE)
  description    String?       @db.Text
  type           ProductType
  priceSell      Int           @map("price_sell")
  priceRentMonth Int           @map("price_rent_month")
  depositFee     Int           @map("deposit_fee")
  stock          Int
  images         Json
  specs          Json
  rentals        RentalOrder[]
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  saleDetails    ProductSaleDetails?
  rentalDetails  ProductRentalDetails?
  scheduledRentals Rental[]
  rentalUnits      RentalUnit[]
  inventoryLogs    InventoryLog[]
  compatibleWith   ProductCompatibility[] @relation("component_compatibility")
  usedByComponents ProductCompatibility[] @relation("device_compatibility")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("products")
}

model RentalOrder {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  productId       String       @map("product_id")
  type            OrderType
  duration        Int
  quantity        Int
  rentFee         Int          @map("rent_fee")
  depositFee      Int          @map("deposit_fee")
  installFee      Int          @map("install_fee")
  total           Int
  startDate       DateTime?      @map("start_date")
  paymentDueAt    DateTime?      @map("payment_due_at")
  depositAmount   Int            @default(0) @map("deposit_amount")
  depositPercent  Int            @default(10) @map("deposit_percent")
  remainingAmount Int            @default(0) @map("remaining_amount")
  remainingPaidAmount Int        @default(0) @map("remaining_paid_amount")
  remainingPaymentStatus RemainingPaymentStatus @default(PENDING) @map("remaining_payment_status")
  remainingPaidAt DateTime?      @map("remaining_paid_at")
  depositRefundedAt DateTime?    @map("deposit_refunded_at")
  status          RentalStatus @default(PENDING)
  shippingAddress Json         @map("shipping_address")
  gateIds         Json?        @map("gate_ids")
  damageNotes     String?      @map("damage_notes")
  user            User         @relation(fields: [userId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])
  tickets         Ticket[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("rental_orders")
}

model Show {
  id            String        @id @default(cuid())
  ownerId       String        @map("owner_id")
  slug          String        @unique
  name          String
  description   String        @db.Text
  bannerUrl     String        @map("banner_url")
  themeColor    String        @map("theme_color")
  location      String
  startAt       DateTime      @map("start_at")
  endAt         DateTime?     @map("end_at")
  ticketPrice   Int           @map("ticket_price")
  totalTickets  Int           @map("total_tickets")
  soldTickets   Int           @default(0) @map("sold_tickets")
  reservedTickets Int         @default(0) @map("reserved_tickets")
  payoutAccount Json          @map("payout_account")
  status        ShowStatus    @default(ACTIVE)
  installationStatus String   @default("PENDING") @map("installation_status")
  scannerCount  Int           @default(0) @map("scanner_count")
  installationNote String?    @map("installation_note")
  owner         User          @relation(fields: [ownerId], references: [id])
  apiKeys       ApiKey[]
  revokedResources RevokedResource[]
  ticketOrders  TicketOrder[]
  tickets       Ticket[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("shows")
}

model TicketOrder {
  id             String            @id @default(cuid())
  showId         String            @map("show_id")
  buyerName      String            @map("buyer_name")
  buyerEmail     String            @map("buyer_email")
  buyerPhone     String?           @map("buyer_phone")
  buyerNote      String?           @map("buyer_note") @db.Text
  quantity       Int
  totalAmount    Int               @map("total_amount")
  platformFee    Int               @map("platform_fee")
  payoutAmount   Int               @map("payout_amount")
  status         TicketOrderStatus @default(PENDING)
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  payosPaymentId String?           @map("payos_payment_id")
  show           Show              @relation(fields: [showId], references: [id])
  tickets        Ticket[]
  payouts        Payout[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("ticket_orders")
}

model Ticket {
  id            String       @id @default(cuid())
  showId        String       @map("show_id")
  rentalOrderId String?      @map("rental_order_id")
  ticketOrderId String?      @map("ticket_order_id")
  jti           String       @unique
  qrJwt         String       @map("qr_jwt") @db.Text
  qrOfflineJwt  String?      @map("qr_offline_jwt") @db.Text
  isUsed        Boolean      @default(false) @map("is_used")
  usedAt        DateTime?    @map("used_at")
  useCount      Int          @default(0) @map("use_count")
  show          Show         @relation(fields: [showId], references: [id])
  rentalOrder   RentalOrder? @relation(fields: [rentalOrderId], references: [id])
  ticketOrder   TicketOrder? @relation(fields: [ticketOrderId], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("tickets")
}

model ApiKey {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  keyHash         String           @unique @map("key_hash")
  prefix          String
  quota           Int              @default(10000)
  scopes          Json             @default("[\"qr:create\",\"qr:read\",\"ticket:verify\"]")
  rentalId        String?          @map("rental_id")
  rental          ApiRentalOrder?  @relation(fields: [rentalId], references: [id])
  showId          String?          @map("show_id")
  show            Show?            @relation(fields: [showId], references: [id])
  status          String           @default("active")
  isTest          Boolean          @default(false) @map("is_test")
  allowedIps      Json             @default("[]") @map("allowed_ips")
  rateLimit       Int              @default(60) @map("rate_limit")
  revokeAt        DateTime?        @map("revoke_at")
  suspendUntil    DateTime?        @map("suspend_until")
  rotationWarnedAt DateTime?        @map("rotation_warned_at")
  user            User             @relation(fields: [userId], references: [id])
  externalQrCodes ExternalQrCode[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("api_keys")
}

model ApiRentalOrder {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  appName        String       @map("app_name")
  website        String?
  callbackUrl    String?      @map("callback_url")
  plan           String
  duration       Int
  quota          Int
  scopes         Json         @default("[\"qr:create\",\"qr:read\",\"ticket:verify\"]")
  total          Int
  status         RentalStatus @default(PENDING)
  payosPaymentId String?      @map("payos_payment_id")
  apiKeyPrefix   String?      @map("api_key_prefix")
  keys           ApiKey[]
  signingEnabled Boolean      @default(false) @map("signing_enabled")
  signingSecret  String?       @map("signing_secret")
  webhookSecret  String?       @map("webhook_secret")
  billingMode    String        @default("fixed") @map("billing_mode")
  createUnitPrice Int          @default(10) @map("create_unit_price")
  verifyUnitPrice Int          @default(1) @map("verify_unit_price")
  commissionRateOverrideBp Int? @map("commission_rate_override_bp")
  user           User         @relation(fields: [userId], references: [id])
  paymentTransactions PaymentTransaction[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("api_rental_orders")
}

model ExternalQrCode {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  apiKeyId     String              @map("api_key_id")
  jti          String              @unique
  code         String              @unique
  qrJwt        String              @map("qr_jwt") @db.Text
  resourceType String              @map("resource_type")
  resourceId   String              @map("resource_id")
  customerRef  String?             @map("customer_ref")
  payload      Json?
  metadata     Json?
  isTest       Boolean             @default(false) @map("is_test")
  maxUses      Int                 @default(1) @map("max_uses")
  useCount     Int                 @default(0) @map("use_count")
  allowedGateIds Json              @default("[]") @map("allowed_gate_ids")
  notBefore    DateTime?           @map("not_before")
  revokedAt    DateTime?           @map("revoked_at")
  expiryNotifiedAt DateTime?       @map("expiry_notified_at")
  expiresAt    DateTime            @map("expires_at")
  isUsed       Boolean             @default(false) @map("is_used")
  usedAt       DateTime?           @map("used_at")
  user         User                @relation(fields: [userId], references: [id])
  apiKey       ApiKey              @relation(fields: [apiKeyId], references: [id])
  scanLogs     ExternalQrScanLog[]
  paymentTransactions PaymentTransaction[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([expiresAt, expiryNotifiedAt])
  @@map("external_qr_codes")
}

model RevokedResource {
  id           String   @id @default(cuid())
  resourceType String   @map("resource_type")
  jti          String
  revokedAt    DateTime @default(now()) @map("revoked_at")
  tenantId     String   @map("tenant_id")
  showId       String?  @map("show_id")
  isTest       Boolean  @default(false) @map("is_test")
  userId       String?  @map("user_id")
  show         Show?    @relation(fields: [showId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceType, jti])
  @@index([tenantId, revokedAt])
  @@index([showId, revokedAt])
  @@map("revoked_resources")
}

model TenantGateKey {
  id                String    @id @default(cuid())
  tenantId          String    @unique @map("tenant_id")
  publicKey         String    @map("public_key") @db.Text
  privateKeyEnc     String    @map("private_key_enc") @db.Text
  algorithm         String    @default("RS256")
  previousPublicKey String?   @map("previous_public_key") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  rotatedAt         DateTime? @map("rotated_at")

  @@map("tenant_gate_keys")
}

model TenantSettings {
  tenantId       String    @id @map("tenant_id")
  offlineCapable Boolean   @default(false) @map("offline_capable")
  enabledAt      DateTime? @map("enabled_at")
  enabledBy      String?   @map("enabled_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model ApiUsagePeriod {
  id            String   @id @default(cuid())
  scopeId       String   @map("scope_id")
  month         String
  isTest        Boolean  @default(false) @map("is_test")
  qrCreated     Int      @default(0) @map("qr_created")
  verifySuccess Int      @default(0) @map("verify_success")
  verifyFailed  Int      @default(0) @map("verify_failed")
  billedAmount  Int      @default(0) @map("billed_amount")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([scopeId, month, isTest])
  @@map("api_usage_periods")
}

model ApiUsageEvent {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  apiKeyId     String   @map("api_key_id")
  rentalId     String?  @map("rental_id")
  action       String
  resourceType String?  @map("resource_type")
  isTest       Boolean  @default(false) @map("is_test")
  units        Int      @default(1)
  cost         Int      @default(0)
  success      Boolean
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, isTest, createdAt])
  @@index([rentalId, createdAt])
  @@map("api_usage_events")
}

model ApiIdempotency {
  id          String   @id @default(cuid())
  scopeId     String   @map("scope_id")
  key         String
  operation   String
  requestHash String   @map("request_hash")
  response    Json
  expiresAt   DateTime @map("expires_at")

  @@unique([scopeId, operation, key])
  @@index([expiresAt])
  @@map("api_idempotency")
}

model ApiRequestLog {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  userId       String?  @map("user_id")
  apiKeyId     String?  @map("api_key_id")
  rentalId     String?  @map("rental_id")
  method       String
  endpoint     String
  statusCode   Int      @map("status_code")
  durationMs   Int      @map("duration_ms")
  ip           String?
  isTest       Boolean  @default(false) @map("is_test")
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, isTest, createdAt])
  @@index([apiKeyId, createdAt])
  @@map("api_request_logs")
}

model WebhookEvent {
  id           String   @id @default(cuid())
  rentalId     String   @map("rental_id")
  event        String
  body         String   @db.Text
  targetUrl    String   @map("target_url")
  secret       String
  dedupeKey    String?  @unique @map("dedupe_key")
  status       String   @default("pending")
  attempts          Int      @default(0)
  manualReplayCount Int      @default(0) @map("manual_replay_count")
  nextAttemptAt     DateTime @default(now()) @map("next_attempt_at")
  lockedUntil  DateTime? @map("locked_until")
  deliveredAt  DateTime? @map("delivered_at")
  createdAt    DateTime @default(now()) @map("created_at")
  logs         WebhookAttempt[]

  @@index([status, nextAttemptAt])
  @@index([rentalId, createdAt])
  @@map("webhook_events")
}

model WebhookAttempt {
  id         String       @id @default(cuid())
  eventId    String       @map("event_id")
  event      WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempt    Int
  statusCode Int?         @map("status_code")
  error      String?
  durationMs Int          @map("duration_ms")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([eventId, createdAt])
  @@map("webhook_attempts")
}

model ApiNotification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  rentalId    String?  @map("rental_id")
  dedupeKey   String   @unique @map("dedupe_key")
  kind        String
  payload     Json
  status      String   @default("pending")
  attempts    Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lockedUntil DateTime? @map("locked_until")
  lastError   String?  @map("last_error")
  sentAt      DateTime? @map("sent_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("api_notifications")
}

model ApiStatusSample {
  id        String   @id @default(cuid())
  healthy   Boolean
  latencyMs Int      @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("api_status_samples")
}

model ApiIncident {
  id         String   @id @default(cuid())
  title      String
  status     String   @default("investigating")
  startedAt  DateTime @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([startedAt])
  @@map("api_incidents")
}

model ExternalQrScanLog {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  externalQrId String         @map("external_qr_id")
  gateId       String         @map("gate_id")
  valid        Boolean
  reason       String?
  ip           String?
  userAgent    String?        @map("user_agent") @db.Text
  externalQr   ExternalQrCode @relation(fields: [externalQrId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([externalQrId, createdAt])
  @@map("external_qr_scan_logs")
}

model Payout {
  id            String       @id @default(cuid())
  showOwnerId   String       @map("show_owner_id")
  ticketOrderId String       @map("ticket_order_id")
  amount        Int
  status        PayoutStatus @default(PENDING)
  showOwner     User         @relation("ShowOwnerPayouts", fields: [showOwnerId], references: [id])
  ticketOrder   TicketOrder  @relation(fields: [ticketOrderId], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("payouts")
}

model PayoutAccount {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  method        PayoutMethod @default(BANK)
  bankName      String?      @map("bank_name")
  accountNumber String?      @map("account_number")
  accountName   String      @map("account_name")
  branch        String?
  walletType    String?      @map("wallet_type")
  walletId      String?      @map("wallet_id")
  isDefault     Boolean      @default(false) @map("is_default")
  status        String       @default("active")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTransactions PaymentTransaction[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([userId, isDefault])
  @@map("payout_accounts")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model PaymentTransaction {
  id                    String        @id @default(cuid())
  userId                String        @map("user_id")
  rentalId              String        @map("rental_id")
  qrCodeId              String?       @map("qr_code_id")
  idempotencyKey        String        @unique @map("idempotency_key")
  grossAmount           Int           @map("gross_amount")
  commissionRateBp      Int           @map("commission_rate_bp")
  commissionAmount      Int           @map("commission_amount")
  userAmount            Int           @map("user_amount")
  payoutAccountId       String?       @map("payout_account_id")
  payoutAccountSnapshot Json?         @map("payout_account_snapshot")
  status                PaymentTransactionStatus @default(PENDING)
  payoutNote            String?       @map("payout_note") @db.Text
  metadata              Json?
  user                  User          @relation(fields: [userId], references: [id])
  rental                ApiRentalOrder @relation(fields: [rentalId], references: [id])
  qrCode                ExternalQrCode? @relation(fields: [qrCodeId], references: [id])
  payoutAccount         PayoutAccount? @relation(fields: [payoutAccountId], references: [id])
  createdAt             DateTime      @default(now()) @map("created_at")
  confirmedAt           DateTime?     @map("confirmed_at")
  payoutCompletedAt     DateTime?     @map("payout_completed_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([rentalId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model StaticPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  navLabel     String   @map("nav_label")
  title        String
  description  String   @db.Text
  heroImage    String   @map("hero_image")
  ctaPrimary   Json     @map("cta_primary")
  ctaSecondary Json?    @map("cta_secondary")
  sections     Json
  sortOrder    Int      @default(0) @map("sort_order")
  published    Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("static_pages")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  method     String?
  path       String?
  ip         String?
  userAgent  String?  @map("user_agent") @db.Text
  metadata   Json?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum ProductType {
  IOT_MINI
  IOT_PRO
  COMPONENT
}

enum OrderType {
  RENT
  BUY
}

enum RentalStatus {
  PENDING
  DEPOSIT_PAID
  DEPOSIT_FORFEITED
  PAID
  SHIPPED
  ACTIVE
  RETURNED
  CANCELLED
}

enum ShowStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum TicketOrderStatus {
  PENDING
  PAID
  EXPIRED
}

enum RemainingPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
}

enum CatalogProductType {
  LINH_KIEN      @map("linh_kien")
  THIET_BI_BAN   @map("thiet_bi_ban")
  THIET_BI_THUE  @map("thiet_bi_thue")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RentalBookingStatus {
  CHO_DUYET  @map("cho_duyet")
  DA_DUYET   @map("da_duyet")
  DANG_THUE  @map("dang_thue")
  DA_TRA     @map("da_tra")
  QUA_HAN    @map("qua_han")
}

enum RentalUnitStatus {
  SAN_SANG   @map("san_sang")
  DANG_THUE  @map("dang_thue")
  BAO_TRI    @map("bao_tri")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  products  Product[]
  parentId   String? @map("parent_id") @db.Uuid
  parent     ProductCategory? @relation("category_tree", fields: [parentId], references: [id])
  children   ProductCategory[] @relation("category_tree")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  @@map("product_categories")
}

model ProductCompatibility {
  componentId String @map("component_id")
  deviceId    String @map("device_id")
  component   Product @relation("component_compatibility", fields: [componentId], references: [id], onDelete: Cascade)
  device      Product @relation("device_compatibility", fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  @@id([componentId, deviceId])
  @@map("product_compatibility")
}

model RentalUnit {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id")
  serial    String @unique
  status    RentalUnitStatus @default(SAN_SANG)
  location  String?
  product   Product @relation(fields: [productId], references: [id])
  rentals   RentalUnitBooking[]
  inventoryLogs InventoryLog[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([productId, status])
  @@map("rental_units")
}

model RentalUnitBooking {
  rentalId String @map("rental_id") @db.Uuid
  unitId   String @map("unit_id") @db.Uuid
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  unit     RentalUnit @relation(fields: [unitId], references: [id])
  @@id([rentalId, unitId])
  @@map("rental_unit_bookings")
}

model InventoryLog {
  id        String @id @default(uuid()) @db.Uuid
  unitId    String? @map("unit_id") @db.Uuid
  productId String @map("product_id")
  quantity  Int
  reason    String?
  userId    String @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  unit      RentalUnit? @relation(fields: [unitId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  user      User @relation(fields: [userId], references: [id])
  @@index([productId, createdAt])
  @@map("inventory_logs")
}

model ProductSaleDetails {
  productId       String  @id @map("product_id")
  giaNhap         Int     @map("gia_nhap")
  giaBan          Int     @map("gia_ban")
  giaKhuyenMai    Int?    @map("gia_khuyen_mai")
  soLuongTon     Int     @default(0) @map("so_luong_ton")
  baoHanhThang   Int     @default(0) @map("bao_hanh_thang")
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("product_sale_details")
}

model ProductRentalDetails {
  productId       String  @id @map("product_id")
  giaThueNgay     Int?    @map("gia_thue_ngay")
  giaThueTuan     Int?    @map("gia_thue_tuan")
  giaThueThang    Int?    @map("gia_thue_thang")
  tienCoc         Int     @default(0) @map("tien_coc")
  tongSoLuong     Int     @default(0) @map("tong_so_luong")
  soLuongKhaDung  Int     @default(0) @map("so_luong_kha_dung")
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("product_rental_details")
}

model Rental {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String
  customerId  String
  tuNgay      DateTime     @map("tu_ngay")
  denNgay     DateTime     @map("den_ngay")
  tongTien    Int          @map("tong_tien")
  tienCoc     Int          @map("tien_coc")
  status      RentalBookingStatus @default(CHO_DUYET)
  product     Product      @relation(fields: [productId], references: [id])
  customer    User         @relation(fields: [customerId], references: [id])
  units       RentalUnitBooking[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  @@index([productId, tuNgay, denNgay])
  @@index([customerId, createdAt])
  @@map("rentals")
}

enum PayoutStatus {
  PENDING
  TRANSFERRED
}

enum PayoutMethod {
  BANK
  WALLET
}

enum PaymentTransactionStatus {
  PENDING
  CONFIRMED
  PAYOUT_PROCESSING
  PAYOUT_COMPLETED
  FAILED
  DISPUTED
}
