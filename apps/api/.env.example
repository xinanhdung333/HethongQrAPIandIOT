DATABASE_URL="postgresql://smartqr:1@localhost:5432/smartqr?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me"
QR_JWT_SECRET="change-me-qr"
PAYMENT_LINK_SECRET="change-me-payment-link"
# Demo payment callbacks are disabled by default and must never be enabled in production.
PAYMENT_DEMO_MODE="false"
QR_JWT_LEGACY_FALLBACK_DAYS="30"
# Set a specific date; do not use days-from-start because every deploy extends the window.
QR_JWT_LEGACY_FALLBACK_UNTIL=""
API_QUOTA_BURST_WINDOW_MINUTES="15"
API_QUOTA_BURST_PERCENT="10"
API_KEY_PEPPER="replace-with-random-server-secret"
# Previous API key pepper kept during a rotation window; losing it invalidates keys not yet rehashed.
API_KEY_PEPPER_PREVIOUS=""
# Number of days old API key hashes remain accepted during pepper rotation.
API_KEY_PEPPER_ROLLOVER_DAYS="30"
# Set a specific date; do not use days-from-start because every deploy extends the window.
API_KEY_PEPPER_ROLLOVER_UNTIL=""
API_KEY_LEGACY_SHA256_UNTIL=""
# AES-256-GCM key for encrypting stored API secrets; losing it prevents decrypting those secrets.
API_SECRET_ENCRYPTION_KEY="replace-with-64-hex-character-secret"
# PayOS webhook verification secret; losing it prevents trusted payment callbacks.
PAYOS_WEBHOOK_SECRET="replace-with-random-webhook-secret"
WEB_ORIGIN="http://localhost:3000"
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM=""
