            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/qr-codes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_type\": \"show-ticket\",\n  \"resource_id\": \"suspended-key-test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Key bi khoa khong tao duoc QR', function () { pm.expect(pm.response.code).to.be.oneOf([401, 403, 429]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Resume API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/keys/{{api_key_id}}/resume"
          }
        },
        {
          "name": "End show",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/shows/{{show_id}}/end"
          }
        }
      ]
    }
  ]
}
