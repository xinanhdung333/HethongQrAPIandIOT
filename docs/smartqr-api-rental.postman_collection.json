            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "sq_live_INVALID_KEY_FOR_POSTMAN_TEST"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_type\": \"postman_demo\",\n  \"resource_id\": \"invalid-key-test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/qr-codes",
              "host": [
                "{{baseUrl}}"
              ],
