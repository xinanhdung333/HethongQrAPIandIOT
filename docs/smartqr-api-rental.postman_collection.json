      "description": "test requires a test key and API Explorer enabled. Use live only with a production key; live may incur charges."
    },
    {
      "key": "createApiKey",
      "value": "",
      "type": "string",
      "description": "API key with qr:create. Store locally in Postman; do not share."
    },
    {
