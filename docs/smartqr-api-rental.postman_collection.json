  "item": [
    {
      "name": "00 - Đăng nhập và thuê API",
      "description": "Chạy lần lượt Lấy CSRF token, Đăng nhập, rồi Tạo đơn thuê API. Cookie csrf_token được lưu trong Postman cookie jar; token được tự gắn vào header X-CSRF-Token. Mở apiRentalPaymentUrl trong trình duyệt để hoàn tất thanh toán demo; sau khi đơn được kích hoạt, tạo/copy API key trong dashboard. Không điền mật khẩu thật vào collection được chia sẻ.",
      "item": [
        {
          "name": "Lấy CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/csrf-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "csrf-token"
              ]
            },
            "description": "Gửi request này đầu tiên. Postman tự lưu cookie csrf_token từ Set-Cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lấy CSRF token thành công', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Response có CSRF token', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
                  "if (data.token) pm.collectionVariables.set('csrfToken', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập SmartQR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Nhập loginEmail và loginPassword trong biến collection Postman của bạn trước khi gửi. Token được lưu tự động trong sessionToken và có hiệu lực 24 giờ."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập thành công (HTTP 200/201)', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "pm.test('Response có access_token', function () { pm.expect(data.access_token).to.be.a('string').and.not.empty; });",
                  "if (data.access_token) pm.collectionVariables.set('sessionToken', data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo đơn thuê API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_name\": \"Postman Demo App\",\n  \"website\": \"https://example.com\",\n  \"plan\": \"starter\",\n  \"duration\": 1,\n  \"scopes\": [\n    \"qr:create\",\n    \"ticket:verify\"\n  ],\n  \"payment_method\": \"payos_demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api-rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api-rentals"
              ]
            },
            "description": "Cần chạy Lấy CSRF token và Đăng nhập trước. Tạo đơn thuê starter 1 tháng bằng phương thức demo, với scope tạo QR và xác minh vé. Request này tạo đơn thật ở trạng thái chờ thanh toán; không phải request sandbox tạo QR."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tạo đơn thuê trả HTTP 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const data = pm.response.json();",
                  "  if (data.order_id) pm.collectionVariables.set('apiRentalOrderId', data.order_id);",
                  "  if (data.payment_url) pm.collectionVariables.set('apiRentalPaymentUrl', data.payment_url);",
                  "  pm.test('Response có mã đơn và link thanh toán', function () { pm.expect(data.order_id).to.be.a('string').and.not.empty; pm.expect(data.payment_url).to.be.a('string').and.not.empty; });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Tạo QR và xác minh thành công",
      "description": "Chạy tuần tự. Request xác minh thành công sẽ đánh dấu QR đã dùng (mặc định max_uses=1).",
      "item": [
        {
          "name": "Tạo QR hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{createApiKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-qr-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_type\": \"postman_demo\",\n  \"resource_id\": \"member-{{$timestamp}}\",\n  \"customer_ref\": \"postman-check\",\n  \"ttl_seconds\": 3600,\n  \"max_uses\": 1,\n  \"payload\": {\n    \"source\": \"postman\",\n    \"plan\": \"starter\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/qr-codes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "qr-codes"
              ]
            },
            "description": "Cần key có scope qr:create. Khi apiMode=test, key phải là test key và API Explorer phải được bật; khi live, dùng key production. Nếu gói bật HMAC, đặt signingSecret ở collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tạo QR trả HTTP 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "pm.test('Response có ticket_code và qr_jwt', function () { pm.expect(data.ticket_code).to.be.a('string').and.not.empty; pm.expect(data.qr_jwt).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('createdTicketCode', data.ticket_code);",
                  "pm.collectionVariables.set('createdQrJwt', data.qr_jwt);",
                  "pm.collectionVariables.set('createdQrId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify QR vừa tạo bằng ticket_code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{verifyApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_code\": \"{{createdTicketCode}}\",\n  \"gate_id\": \"postman-gate-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "verify"
              ]
            },
            "description": "Cần key có scope ticket:verify và cùng tenant/rental + môi trường với QR. Chỉ chạy một lần cho QR max_uses=1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verify trả HTTP 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "pm.test('QR được xác minh thành công', function () { pm.expect(pm.response.json().valid).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify QR vừa tạo bằng qr_jwt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{verifyApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_jwt\": \"{{createdQrJwt}}\",\n  \"gate_id\": \"postman-gate-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "verify"
              ]
            },
            "description": "Tạo một QR mới trước khi chạy request này nếu QR trước đó đã được verify, vì QR mặc định chỉ dùng một lần."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verify bằng JWT trả HTTP 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "pm.test('QR được xác minh thành công', function () { pm.expect(pm.response.json().valid).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
