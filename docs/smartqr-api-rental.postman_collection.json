        {
          "name": "Verify bằng key chỉ có qr:create (kỳ vọng 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{createOnlyApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_code\": \"SQR-SCOPE-CHECK\",\n  \"gate_id\": \"postman-gate-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "verify"
              ]
            },
            "description": "Đặt createOnlyApiKey thành key hợp lệ của cùng rental có qr:create nhưng không có ticket:verify. Nếu để trống/sai, kết quả sẽ là 401 thay vì 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Key thiếu scope bị từ chối HTTP 403', function () { pm.expect(pm.response.code).to.eql(403); });",
                  "pm.test('Lỗi đúng là forbidden_scope', function () { pm.expect(pm.response.json().error).to.eql('forbidden_scope'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo QR với resource_type thiếu (kỳ vọng 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
