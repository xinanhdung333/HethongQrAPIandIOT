                "exec": [
                  "pm.test('status response has status label', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json).to.have.property('checked_at');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
