        {
          "name": "Get QR SVG",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/qr-codes/{{qr_id}}/svg"
          }
        },
        {
          "name": "Bulk create QR codes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{idempotency_key}}-qr-bulk"
              }
            ],
            "url": "{{baseUrl}}/api/v1/qr-codes/bulk",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resources\": [\n    {\n      \"resource_type\": \"ticket\",\n      \"resource_id\": \"ticket-{{$timestamp}}-1\",\n      \"ttl_seconds\": 3600\n    },\n    {\n      \"resource_type\": \"ticket\",\n      \"resource_id\": \"ticket-{{$timestamp}}-2\",\n      \"ttl_seconds\": 3600\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Negative - create QR without API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/qr-codes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_type\": \"order\",\n  \"resource_id\": \"missing-api-key\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing API key is rejected', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke QR code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{idempotency_key}}-qr-revoke"
              }
            ],
            "url": "{{baseUrl}}/api/v1/qr-codes/{{qr_id}}/revoke"
          }
        }
      ]
    },
    {
      "name": "07 - Ticket Verify / Payment",
      "item": [
        {
          "name": "Verify ticket by ticket_code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{idempotency_key}}-ticket-verify"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tickets/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_code\": \"{{ticket_code}}\",\n  \"gate_id\": \"{{gate_id}}\"\n}"
            }
          }
        },
        {
          "name": "Negative - verify ticket with wrong gate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tickets/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_code\": \"{{ticket_code}}\",\n  \"gate_id\": \"wrong-gate\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('wrong gate is rejected or marked invalid', function () {",
                  "  if (pm.response.code >= 400) {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 404, 409, 422]);",
                  "  } else {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.valid === false || json.status === 'invalid' || json.allowed === false).to.equal(true);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create payment transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{idempotency_key}}-payment"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gross_amount\": 100000,\n  \"qr_code_id\": \"{{qr_id}}\",\n  \"metadata\": {\n    \"source\": \"postman\",\n    \"reference\": \"pay-{{$timestamp}}\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const json = pm.response.json();",
                  "  const id = json.id || json.payment_id || (json.payment && json.payment.id);",
                  "  if (id) pm.collectionVariables.set('payment_id', id);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Developer list payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/payments?page=1"
          }
        }
      ]
    },
    {
      "name": "08 - Developer Audit / Webhooks",
      "item": [
        {
          "name": "Developer analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/analytics"
          }
        },
        {
          "name": "Developer audit",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/audit?page=1"
          }
        },
        {
          "name": "Developer audit export CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/audit/export"
          }
        },
        {
          "name": "Developer security events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/security-events?page=1"
          }
        },
        {
          "name": "Developer webhooks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/webhooks?page=1"
          }
        }
      ]
    },
    {
      "name": "09 - Cleanup / Optional",
      "item": [
        {
          "name": "Return rental order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/rentals/{{rental_id}}/return"
          }
        },
        {
          "name": "Suspend API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/keys/{{api_key_id}}/suspend",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"until\": \"2026-10-01T00:00:00.000Z\"\n}"
            }
          }
        },
        {
          "name": "Resume API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/developer/keys/{{api_key_id}}/resume"
          }
        },
        {
          "name": "Logout customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    }
  ]
}
