  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const method = pm.request.method.toUpperCase();",
          "const safeMethods = ['GET', 'HEAD', 'OPTIONS'];",
          "const baseUrl = pm.variables.replaceIn(pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl') || 'http://localhost:4000');",
          "const requestUrl = pm.variables.replaceIn(pm.request.url.toString());",
          "let pathname = requestUrl;",
          "try {",
          "  pathname = new URL(requestUrl).pathname;",
          "} catch (error) {",
          "  pathname = requestUrl.replace(baseUrl, '').split('?')[0];",
          "}",
          "",
          "const csrfExemptPrefixes = ['/api/v1/', '/webhooks/', '/api/thanh-toan/'];",
          "const needsCsrf = !safeMethods.includes(method) && !csrfExemptPrefixes.some((prefix) => pathname.startsWith(prefix));",
          "if (needsCsrf) {",
          "  pm.sendRequest({ url: baseUrl + '/api/csrf-token', method: 'GET' }, function (error, response) {",
          "    if (error) {",
          "      throw error;",
          "    }",
          "",
          "    const json = response.json();",
          "    const token = json && json.token;",
          "    if (!token) {",
          "      throw new Error('Missing CSRF token from /api/csrf-token');",
          "    }",
          "",
          "    const setCookie = response.headers.get('Set-Cookie') || '';",
          "    const cookieValue = (setCookie.match(/csrf_token=([^;]+)/) || [])[1] || token;",
          "    pm.collectionVariables.set('csrf_token', token);",
          "    pm.collectionVariables.set('csrf_cookie', cookieValue);",
          "    pm.request.headers.upsert({ key: 'X-CSRF-Token', value: token });",
          "    pm.request.headers.upsert({ key: 'Cookie', value: 'csrf_token=' + cookieValue });",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is not 5xx', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
