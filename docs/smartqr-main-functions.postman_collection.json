                "exec": [
                  "pm.test('register returns token or duplicate error', function () {",
                  "  pm.expect([200, 201, 400, 409]).to.include(pm.response.code);",
                  "});",
                  "try {",
                  "  const json = pm.response.json();",
                  "  const token = json.token || json.access_token || json.accessToken;",
                  "  if (token) pm.collectionVariables.set('auth_token', token);",
